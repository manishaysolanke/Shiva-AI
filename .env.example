# Shiv AI Environment Configuration

# Database: SQLite by default for instant local execution, or PostgreSQL in production
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/shiv_ai?schema=public"

# Auth Session Secret (used for signing JWT session cookies)
AUTH_SECRET="shiv_ai_jwt_super_secret_session_key_production_2026"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Image Generation Provider Keys (Optional: works out-of-the-box with built-in neural fallback if unset)
# AI_PROVIDER can be 'auto', 'openai', 'replicate', 'fal', 'stability', or 'procedural'
AI_PROVIDER="auto"
OPENAI_API_KEY=""
REPLICATE_API_TOKEN=""
FAL_KEY=""
STABILITY_API_KEY=""

# Payments (Razorpay for Indian Rupee ₹ INR and global cards)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Admin Dashboard Access Key
ADMIN_SECRET_KEY="shiv_admin_2026_super_key"

# Cloud Object Storage (AWS S3 / Supabase Storage / Cloudflare R2)
STORAGE_BUCKET="shiv-ai-generations"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""
