# Shiv AI Environment Configuration

# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# -------------------------------------------------------------
# Transaction Mode Connection String (Pooler - Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Mode Connection String (Session / Migration - Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# 2. AUTHENTICATION & APP CONFIG
# -------------------------------------------------------------
AUTH_SECRET="shiv_ai_jwt_super_secret_session_key_production_2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_SECRET_KEY="shiv_admin_2026_super_key"

# -------------------------------------------------------------
# 3. AI IMAGE GENERATION PROVIDERS (Optional)
# -------------------------------------------------------------
# If unset, Shiv AI automatically uses high-performance Flux.1 / Stable Diffusion neural synthesis
AI_PROVIDER="auto"
OPENAI_API_KEY=""
REPLICATE_API_TOKEN=""

# -------------------------------------------------------------
# 4. PAYMENTS (Razorpay for Indian Rupee ₹ INR)
# -------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STORAGE_BUCKET="shiv-ai-generations"
